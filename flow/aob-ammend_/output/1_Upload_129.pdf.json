            "content": [
              {
                "type": "ministry",
                "heading": "DEPARTMENT OF SPACE",
                "heading_hi": "ANTAREEKSH VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "All matters relating to Space Science, Space Technology, and Space Applica-- tions including-"
              },
              {
                "type": "item",
                "num": "i",
                "text": "research (Including fundamental research) in matters connected with- Space and the development of its uses : [PART II (11) all matters connected with Space Technology."
              },
              {
                "type": "item",
                "num": "iii",
                "text": "all matters connected with Space Applications (Iv) all activities connected with the development and use of outer Space including-"
              },
              {
                "type": "item",
                "num": "a",
                "text": "projects and industries concerned with the utilisation of outer Space"
              },
              {
                "type": "item",
                "num": "b",
                "text": "the design, manufacture and launching of Rockets and Satellites; and"
              },
              {
                "type": "item",
                "num": "c",
                "text": "work connected with Space Applications."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Financial Assistance for the furtherance of research and study in Space Science and Space Technology and for building up adequate trained man-power for the development of the Space programme including— (1) assistance to institutions and associations engaged in scientific work and to Universities for advanced study and research in Space Science: and"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "grant of scholarships to students in educational institutions, and other forms of financial ald to individuals including those going abroad for studies in the field of Space Science."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "International relations in matters connected with Space including- (1) matters relating to Space in the United Nations specialised agencies and relations with other countries; and"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "correspondence with Universities and other educational Institutions abroad in connection with foreign scholarships and the training of Indian scientists."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "All matters relating to the personnel under the control of the Department."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Execution of works and purchase of lands debitable to the budget of the Department. 6, Procurement of stores and equipment required by the Department."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Financial sanctions relating to the Department."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "All matters relating to the Physical Research Laboratory, Ahmedabad."
              }
            ],
