            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF ROAD TRANSPORT AND HIGHWAYS",
                "heading_hi": "SADAK PARIVAHAN AUR RAJ MARG VIBHAG"
              },
              {
                "type": "group_heading",
                "num": "I",
                "text": "THE FOLLOWING SUBJECTS WHICH FALL WITHIN LIST 1 OF THE SEVENTH SCHEDULE TO THE CONSTITUTION OF INDIA:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Compulsory insurance of motor vehicles."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Administration of the Road Transport Corporations Act, 1950 (64 of 1950)."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Highways declared by or under law made by Parliament to be national highways."
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "IN RESPECT OF THE UNION TERRITORIES:"
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Roads other than National Highways."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Tramways including elevated high speed trams within municipal limits or any other contiguous zone."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Administration of the Motor Vehicles Act, 1988 (59 of 1988) and taxation of motor vehicles."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Vehicles other than mechanically propelled vehicles. III OTHER SUBJECTS WHICH HAVE NOT BEEN INCLUDED UNDER THE PREVIOUS PARTS:"
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Central Road Fund."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Coordination and Research pertaining to Road Works."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Road works financed in whole or in part by the Central Government other than rural roads and the road works in the tribal areas in the States of Assam and Meghalaya specified in Parts I and II of the table appended to Paragraph 20 of the Sixth Schedule to the Constitution."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Motor vehicles legislation."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Promotion of Transport Co-operatives in the field of motor transport and inland water transport."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Development of townships of Gandhidham."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Formulation of the privatisation policy in the infrastructure areas of roads."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "AUTONOMOUS BODIES:"
              },
              {
                "type": "entry",
                "num": "15",
                "text": "National Highways Authority of India."
              },
              {
                "type": "group_heading",
                "num": "V",
                "text": "SOCIETIES/ASSOCIATIONS:"
              },
              {
                "type": "entry",
                "num": "16",
                "text": "National Institute of Training for Highway Engineers."
              },
              {
                "type": "group_heading",
                "num": "VI",
                "text": "PUBLIC SECTOR UNDERTAKINGS:"
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Indian Road Construction Corporation. Road"
              },
              {
                "type": "group_heading",
                "num": "VII",
                "text": "ACTS:"
              },
              {
                "type": "entry",
                "num": "18",
                "text": "The Road Transport Corporations Act, 1950 (64 of 1950)."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "The National Highway Act, 1956 (48 of 1956)."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "The Motor Vehicles Act, 1988 (59 of 1988)."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "The National Highways Authority of India Act 1988 (68 of 1988). 1"
              },
              {
                "type": "entry",
                "num": "22",
                "text": "The Multimodal Transportation of Goods Act 1993 (28 of 1993)."
              }
