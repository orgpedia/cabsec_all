            "content": [
              {
                "type": "text",
                "text": "I General International Trade Policy"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "International Commercial Policy."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "International agencies principally connected with commercial policy (e.g., [UNCTAD ECAFE, ECA, ECIA, EEC, EFTA, GATT)."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "International Commodity Agreements other than agreements relating to Wheat. 4- All matters relating to international trade policy including tariff and non-tariff barriers. ( 1239 [PART -"
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Tariff Commission (The Tariff Commission Act, 1951),Tariff Protection to Industries International Customs Tariff Bureau"
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "Foreign Trade"
              },
              {
                "type": "entry",
                "num": "6",
                "text": "All matters relating to foreign trade including trade negotiations and agreements (including General Agreement on Tariffs and Trade and Commonweatlh Tariff Preferences), trade missions and delegations, trade cooperation and promotion, and protection of interests of Indian traders abroad."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Development and expansion of export production in relation to all commodities, products manufactures, and semi-manufactures including the following:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "agricultural produce within the meaning of the Agricultural Produce (Grading and Marking) Act, 1937 (1 of 1937)"
              },
              {
                "type": "item",
                "num": "b",
                "text": "marine products"
              },
              {
                "type": "item",
                "num": "c",
                "text": "industrial products (engineering goods, chemicals, plastics, leather products etc.)"
              },
              {
                "type": "item",
                "num": "d",
                "text": "fuels, minerals and mineral products"
              },
              {
                "type": "item",
                "num": "e",
                "text": "specific export-oriented products (textiles, jute products, handicrafts, plantation crops etc.) which are directly the charge of this Department."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "All organisations and institutions connected with the provision of services relating to the export effort including:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Export Credit and Guarantee Corporation."
              },
              {
                "type": "item",
                "num": "b",
                "text": "Export Inspection Council."
              },
              {
                "type": "item",
                "num": "c",
                "text": "Directorate General of Commercial Intelligence and Statistics."
              },
              {
                "type": "item",
                "num": "d",
                "text": "Directorate of Exhibitions and Commercial Publicity."
              },
              {
                "type": "item",
                "num": "c",
                "text": "Free Trade Zones."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Projects and programmes for stimulating and assisting the export effort."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Import and Export Trade Policy and Control excluding the matters relating to---"
              },
              {
                "type": "item",
                "num": "i",
                "text": "import of feature films"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "export of Indian films-both feature length and shorts; and"
              },
              {
                "type": "item",
                "num": "iii",
                "text": "import and distribution of cine-film (unexposed) and other goods required by the film industry."
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "Chief Controller of Imports and Exports."
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "Export-oriented Industries"
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Production, distribution (for domestic consumption and exports) and development of:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "All textiles, including handlooms and readymade garments, but excluding industries relating to the production of silk and non-cellulosic synthetic fibres (nylon, terylene polyester, acrylic)."
              },
              {
                "type": "item",
                "num": "b",
                "text": "jute."
              },
              {
                "type": "item",
                "num": "c",
                "text": "handicrafts."
              },
              {
                "type": "item",
                "num": "d",
                "text": "plantation crops, tea, coffee, rubber and cardamom."
              },
              {
                "type": "entry",
                "num": "13",
                "text": ""
              },
              {
                "type": "item",
                "num": "i",
                "text": "Textile Commissioner."
              },
              {
                "type": "item",
                "num": "i",
                "text": "Jute Commissioner."
              },
              {
                "type": "item",
                "num": "iii",
                "text": "Cotton Corporation of India Ltd."
              },
              {
                "type": "item",
                "num": "iv",
                "text": "Jute Corporation of India Ltd."
              },
              {
                "type": "item",
                "num": "v",
                "text": "Tea Trading Corporation of India Ltd."
              },
              {
                "type": "item",
                "num": "vi",
                "text": "All India Handicrafts Board."
              },
              {
                "type": "item",
                "num": "vii",
                "text": "All India Handloom Board. (viii) Tea Board."
              },
              {
                "type": "item",
                "num": "ix",
                "text": "Coffee Board."
              },
              {
                "type": "item",
                "num": "x",
