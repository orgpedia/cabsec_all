            "content": [
              {
                "type": "ministry",
                "heading": "DEPARTMENT OF OCEAN DEVELOPMENT",
                "heading_hi": "MAHASAGAR VIKAS VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Matters relating to the Ocean and not specifically allocated to any other Department/Ministry."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Policies, including coordination, security, regulatory measures and development relating to the Ocean and covering, inter-alia,—"
              },
              {
                "type": "item",
                "num": "i",
                "text": "research (including fundamental research) and the development of uses relatable thereto"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "technological development"
              },
              {
                "type": "item",
                "num": "iii",
                "text": "surveys to map and locate the availability of nonliving and living marine resources"
              },
              {
                "type": "item",
                "num": "iv",
                "text": "preservation, conservation and protection"
              },
              {
                "type": "item",
                "num": "v",
                "text": "development of appropriate skills and manpower"
              },
              {
                "type": "item",
                "num": "vi",
                "text": "collaboration, including technical collaboration; and"
              },
              {
                "type": "item",
                "num": "vii",
                "text": "laws relatable to the above."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Ocean Commission."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "The Pan-Indian Ocean Science Association."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Ocean Science and Technology Agency or Board."
              }
