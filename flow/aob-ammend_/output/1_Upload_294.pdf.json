            },
            "content": [
              {
                "type": "entry",
                "num": "1",
                "text": "Implementation of treaties and agreements relating to matters dealt within the Department of Posts with other countries."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Execution of works, including purchase of land debitable to the Capital Budget pertaining to the Department of Posts."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Posts, including Post Office Savings Banks (Administration), Post Office Certificate (Administration), Post Office Life Insurance Fund (Administration), printing of public postage stamps/commemorative stamps, premium postal products and any agency function."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "International relations in matters connected with postal communications, including matters relating to all international bodies dealing with postal communications such as Universal Postal Union. Asia Pacific Postal Union (APPU), Commonwealth Postal Union."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Matters relating to introduction, development and maintenance of all Postal Services including those based on cable, radio and Satellite communications channels:"
              },
              {
                "type": "proviso",
                "text": "Provided that these matters do not amount to broadcasting, narrowcasting, cable and radio networking services and are also not governed by the Indian Telegraph Act, 1885 and the rules made thereunder."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Promotion of feasibility survey, research and development in the field of activities allotted to the Department."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Matters relating to administration of the Indian Post Office Act, 1898 and rules made thereunder as well as other law's or enactments having a bearing on postal activities, not specifically allotted to any other Department."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Offences against laws with respect to any of the matters specified in this list"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Inquiries and statistics for the purposes of any of the matters specified in this list."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Fees in respect of any of the matters specified in this list but not including fees taken in any court."
              }
            ],
