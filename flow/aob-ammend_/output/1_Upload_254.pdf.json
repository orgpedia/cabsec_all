            "content": [
              {
                "type": "department",
                "num": "E",
                "heading": "DEPARTMENT OF ANIMAL HUSBANDRY AND DAIRY ING PART - I",
                "heading_hi": "PASHUPALAN AUR DAIRY VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "43-4 The following subjects which fall within List I of the Seventh Schedule to the Constitution of India:-"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Industries, the control of which by the Union is declared by Parliament by law to be expedient in Public interest as far as these relate to development of cattlefeed with the limitation that in regard to the development of industries the functions of the Department of Animal Husbandry and Dairying (Pashupalan aur Dairy Vibhag) do not go further than the formulation of demand and fixation of targets. VS. copies. .....4/- 4"
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Livestock Census."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Matters relating to loss of livestock due to natural calamities."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II",
                "text": "The following subjects which fall within List III of the Seventh Schedule to the Constitution of India (as regards legislation only):-"
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Profession of Veterinary Practice."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Prevention of the extension from one State to another of infectious or contagious diseases or pests. affecting animals."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Pattern of financial assistance to various State Undertakings Dairy Development Schemes either through their own agencies or through the Cooperative Unions."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Operation Flood Programme and all matters pertaining thereto."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Technology Mission on Dairy Development. PART G III ALT ▼ For the Union territories the subjects mentioned in parts I and II above, so far as they exist in regard to these territories and, in addition, to the following subjects which fall within List II of the Seventh Schedule to the Constitution of India:~"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Preservation, protection and improvement of stocks. and prevention of animal diseases; Veterinary training and practice. 5/- GP * 10"
              },
              {
                "type": "entry",
                "num": "5",
                "text": "."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Courts of Wards. ll. Insurance (Cattle). PART - IV"
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Matters relating to animal husbandry including"
              },
              {
                "type": "item",
                "num": "a",
                "text": "pounds and cattle trespass; (b) cattle utilisation and slaughter."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "All attached and subordinate offices or other organisations concerned with any of the subjects specified in this list. 27"
              }
