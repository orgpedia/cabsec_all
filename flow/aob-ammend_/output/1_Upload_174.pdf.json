            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF SOCIAL WELFARE",
                "heading_hi": "SAMAJ KALYAN MANTRALAYA"
              },
              {
                "type": "part",
                "num": "I",
                "heading": "PART I",
                "text": "The following subjects which fall within list of the Seventh Schedule to the Constitution of India: Nil."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II",
                "text": "The following subject which falls within List III of the Seventh Schedule to the Constitution of India (as regards legislation only) :"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Social Security and Social Insurance, save to the extent allotted to any other Department."
              },
              {
                "type": "part",
                "num": "III",
                "heading": "PART III",
                "text": "For the Union territories, the following subjects which fall within List II or List Ill of the Seventh Schedule to the Constitution of India, in so far as they exist in regard to such territories: 2, Relief of the disabled and unemployable and measures relating to social security and social insurance, save to the extent allotted to any other Department."
              },
              {
                "type": "part",
                "num": "IV",
                "heading": "PART IV",
                "text": "General and Consequential:"
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Social Welfare; social welfare planning; project formulation, research, evaluation, statistics and training."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Family Welfare."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Woman and child welfare and co-ordination of activities of other Ministries and Organisations in connection with this subject."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "References from the United Nations Organisation relating to traffic in women and children."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Conventions with other countries in matters relating to social defence."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Care of pre-school children."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Coordination of National Nutrition programme Nutrition feeding of pre-school children and Nutrition education of women."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Institutional and non-institutional services for the care and development of children in need including orphans and orphanages."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "United Nations International Children's Emergency Fund (UNICEF)."
              },
              {
                "type": "entry",
                "num": "12",
