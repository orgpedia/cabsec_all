            "content": [
              {
                "type": "text",
                "text": "APPENDIX"
              },
              {
                "type": "ministry",
                "heading": "MINISTRY OF ECONOMIC AND DEFENCE CO-ORDINATION * Y"
              },
              {
                "type": "department",
                "num": "A",
                "heading": "Department of Supply:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Purchase, inspection and shipment of stores for the Central Government other than the items the purchase, inspection and shipment of which are delegated to other authorities by a general or special order."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Disposal of surplus stores."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Residual work of supply and disposal relating to the late war organisations including the Directorate General, Aircraft including Civil Maintenance Units and Directorate General, Ship Repairs."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Administration of:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Directorate General of Supplies and Disposals"
              },
              {
                "type": "item",
                "num": "b",
                "text": "Government Test House, Alipore, Calcutta"
              },
              {
                "type": "item",
                "num": "c",
                "text": "India Store Department, the United Kingdom"
              },
              {
                "type": "item",
                "num": "d",
                "text": "India Supply Mission, the U.S.A."
              },
              {
                "type": "department",
                "num": "B",
                "heading": "Department of Co-ordination:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Co-ordination of civil and defence production and supplies."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Such other subjects as may be assigned by the Prime Minister from time to time."
              },
              {
                "type": "department",
                "num": "C",
                "heading": "Department of Technical Development:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "The Development Wing."
              }
            ],
