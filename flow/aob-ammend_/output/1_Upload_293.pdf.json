            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF SHIPPING (POT PARIVAHAN MANTRALYA)"
              },
              {
                "type": "group_heading",
                "num": "I",
                "text": "THE FOLLOWING SUBJECTS WHICH FALL WITHIN LIST 1 OF THE SEVENTH SCHEDULE TO THE CONSTITUTION OF INDIA:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Maritime shipping and navigation; provision of education and training for the mercantile marine."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Lighthouses and lightships. 315762/200-2"
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Administration of the Indian Ports Act, 1908 (15 of 1908) and the Major Port Trusts Act 1963 (38 of 1963) and ports declared as major ports."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Shipping and navigation including carriage of passengers and goods on inland waterways declared by Parliament by law to be national waterways as regards mechanically propelled vessels, the rule of the road on such waterways."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Ship-building and ship-repair industry."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Fishing vessels industry."
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Floating craft industry."
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "IN RESPECT OF THE UNION TERRITORIES:"
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Inland waterways and traffic thereon."
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "IN RESPECT OF THE UNION TERRITORIES OF THE ANDAMAN AND NICOBAR ISLANDS AND THE LAKSHADWEEP:"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Organisation and maintenance of mainland islands and inter-island shipping services."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "OTHER SUBJECTS WHICH HAVE NOT BEEN INCLUDED UNDER THE PREVIOUS PARTS:"
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Legislation relating to shipping and navigation on inland waterways as regards mechanically propelled vessels and the carriage of passengers and goods on inland waterways."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Legislation relating to and coordination of the development of minor and major ports."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Administration of the Dock Workers (Regulation of Employment) Act, 1948 (9 of 1948) and the Schemes framed thereunder other than the Dock Workers (Safety, Health and Welfare) Scheme, 1961."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "To make shipping arrangements for and on behalf of the Government of India/Public Sector Undertakings/State Governments/ State Government Public Sector Undertakings and autonomous bodies in respect of import of cargo on Free on Board/Free along Site and export on Cost and Freight/CostInsurance and Freight basis."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Formulation of the privatisation policy in the infrastructure areas of ports, shipping and inland waterways."
              },
              {
                "type": "group_heading",
                "num": "V",
                "text": "SUBORDINATE OFFICES:"
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Directorate General of Shipping."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Andaman Lakshadweep Harbour Works."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Directorate General of Lighthouses and Lightships."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Minor Ports Survey Organisation."
              },
              {
                "type": "group_heading",
                "num": "VI",
                "text": "AUTONOMOUS BODIES:"
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Port Trusts at Mumbai, Calcutta, Kochi, Kandla Chennai, Mormugao, Jawahar Lal Nehru (Nhava Sheva), Paradip, Tuticorin, Visakhapatnam and New Mangalore."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Dock Labour Boards at Calcutta, Kandla, Chennai Mormugao and Visakhapatnam."
              },
              {
                "type": "entry",
                "num": "21",
