            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF HOUSING AND URBAN AFFAIRS",
                "heading_hi": "AWASAN AUR SHAHARI KARYA MANTRALAYA"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Properties of the Union, whether lands or buildings, with the following exceptions, namely:-"
              },
              {
                "type": "item",
                "num": "a",
                "text": "those belonging to the Ministry of Defence, the Ministry of Railways and the Department of Atomic Energy and the Department of Space"
              },
              {
                "type": "item",
                "num": "b",
                "text": "buildings or lands, the construction or acquisition of which has been financed otherwise than from the Civil Works Budget"
              },
              {
                "type": "item",
                "num": "c",
                "text": "buildings or lands, the control of which has at the time of construction or acquisition or subsequently been permanently made over to other Ministries and Departments."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "All Government civil works and buildings including those of Union territories excluding roads and excluding works executed by or buildings belonging to the Ministry of Railways, Department of Posts Department of Telecommunications, Department of Atomic Energy and the Department of Space."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Horticulture operations."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Central Public Works Organisation."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Administration of Government estates including Government hostels under the control of the Ministry. Location or dispersal of offices in or from the metropolitan cities."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Allotment of accommodation in Vigyan Bhawan."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Administration of four Rehabilitation Markets viz. Sarojini Nagar Market, Shankar Market, Pleasure Garden Market and Kamla Market."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Issue of lease or conveyance deeds in respect of Government built properties in Delhi and New Delhi under the Displaced Persons (Compensation and Rehabilitation) Act, 1954 (44 of 1954) and conversion of lease deeds, allotment of additional strips of land and correctional areas adjoining such properties."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Stationery and Printing for the Government of India including official publications."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Planning and coordination of urban transport systems with technical planning of rail based systems being subject to the items of work allocated to the Ministry of Railways, Railway Board."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Fixing of maximum and minimum rates and fares for rail-based urban transport systems other than those funded by the Indian Railways."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Tramways including elevated high speed trams within municipal limits or any other contiguous zone."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Town and Country Planning; matters relating to the Planning and Development of Metropolitan Areas International Cooperation and Technical Assistance in this field."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Schemes of large scale acquisition, development and disposal of land in Delhi."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Delhi Development Authority."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Master Plan of Delhi, coordination of work in respect of the Master Plan and Slum Clearance in the National Capital Territory of Delhi."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Erection of memorials in honour of freedom fighters."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Development of Government colonies."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Local Government, that is to say, the constitution and powers of the Municipal Corporations (excluding the Municipal Corporation of Delhi), Municipalities (excluding the New Delhi Municipal Committee) other Local Self-Government Administrations excluding Panchayati Raj Institutions."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "The Delhi Water Supply and Sewage Disposal Undertaking of the Municipal Corporation of Delhi."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Water supply (subject to overall national perspective of water planning and coordination assigned to the Ministry of Water Resources, River Development and Ganga Rejuvenation), sewage, drainage and sanitation relating to urban areas and linkages from allocated water resources. International Cooperation and Technical Assistance in this field."
              },
              {
                "type": "entry",
                "num": "22",
                "text": "The Central Council of Local Self-Government."
              },
              {
                "type": "entry",
                "num": "23",
                "text": "Allotment of Government land in Delhi."
              },
              {
                "type": "entry",
                "num": "24",
                "text": "Administration of Rajghat Samadhi Committee."
              },
              {
                "type": "entry",
                "num": "25",
                "text": "All matters relating to Planning and Development of the National Capital Region and administration of the National Capital Region Planning Board Act, 1985 (2 of 1985)."
              },
              {
                "type": "entry",
                "num": "26",
                "text": "Matters relating to the Indian National Trust for Art and Cultural Heritage (INTACH)."
              },
              {
                "type": "entry",
                "num": "27",
                "text": "All matters relating to the Housing and Urban Development Corporation (HUDCO)."
              },
              {
                "type": "entry",
                "num": "28",
                "text": "Formulation of housing policy and programme (except rural housing which is assigned to the Department of Rural Development), review of the implementation of the Plan Schemes, collection and dissemination of data on housing, building materials and techniques, general measures for reduction of building costs and nodal responsibility for National Housing Policy."
              },
              {
                "type": "entry",
                "num": "29",
                "text": "Human Settlements including the United Nations Commission for Human Settlements and International Cooperation and Technical Assistance in the field of Housing and Human Settlements."
              },
              {
                "type": "entry",
                "num": "30",
                "text": "Urban Development including Slum Clearance Schemes and the Jhuggi and Jhonpri Removal Schemes. International Cooperation and Technical Assistance in this field."
              },
              {
                "type": "entry",
                "num": "31",
                "text": "National Cooperative Housing Federation."
              },
              {
                "type": "entry",
                "num": "32",
                "text": "Implementation of the specific programmes of Urban Employment and Urban Poverty Alleviation including other programmes evolved from time to time."
              },
              {
                "type": "entry",
                "num": "33",
                "text": "Administration of the Requisitioning and Acquisition of Immovable Property Act, 1952 (30 of 1952)."
              },
              {
                "type": "entry",
                "num": "34",
                "text": "Administration of Delhi Hotels (Control of Accommodation) Act, 1949 (24 of 1949)."
              },
              {
                "type": "entry",
                "num": "35",
                "text": "The Public Premises (Eviction of Unauthorised Occupants) Act, 1971 (40 of 1971)."
              },
              {
                "type": "entry",
                "num": "36",
                "text": "Administration of the Delhi Development Act, 1957 (61 of 1957)."
              },
              {
                "type": "entry",
                "num": "37",
                "text": "The Delhi Rent Control Act, 1958 (59 of 1958)."
              },
              {
                "type": "entry",
                "num": "38",
                "text": "The Urban Land (Ceiling and Regulation) Act, 1976 (33 of 1976)."
              },
              {
                "type": "entry",
                "num": "39",
                "text": "Delhi Urban Art Commission, the Delhi Urban Art Commission Act, 1973 (1 of 1974)."
              }
            ],
