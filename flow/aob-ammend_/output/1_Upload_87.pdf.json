              {
                "type": "entry",
                "num": "3",
                "text": "Beacons and other provisions for the safety of aircraft."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Carriage of passengers and goods by air."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Corporations established under the Air Corporations Act, 1953."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Railway Inspectorate."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Development of tourism."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Offences against laws with respect to any of the matters specified in this Ilst."
              },
              {
                "type": "entry",
