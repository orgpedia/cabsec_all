              {
                "type": "ministry",
                "heading": "MINISTRY OF ELECTRONICS AND INFORMATION TECHNOLOGY",
                "heading_hi": "ELECTRONIKI AUR SOOCHANA PRAUDYOGIKI MANTRALAYA"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Policy matters relating to information technology; Electronics; and Internet (all matters other than licensing of Internet Service Provider)."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Promotion of internet, IT and IT enabled services."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Assistance to other departments in the promotion of E-Governance, E- Commerce, E- Medicine E- Infrastructure, etc."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Promotion of Information Technology education and Information Technology-based education."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Matters relating to Cyber Laws, administration of the Information Technology Act, 2000 (21 of 2000) and other IT related laws."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Matters relating to promotion and manufacturing of Semiconductor Devices in the country excluding all matters relating to Semiconductor Complex Limited (SCL), Mohali."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Interaction in IT related matters with international agencies and bodies e. g. Internet for Business Limited (IFB), Institute for Education in Information Society (IBI) and International Code Council – on line (ICC)."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Initiative on bridging the Digital Divide: Matters relating to Media Lab Asia."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Promotion of Standardization, Testing and Quality in IT and standardization of procedure for IT application and Tasks."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Electronics Export and Computer Software Promotion Council (ESC)."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "National Informatics Centre (NIC)."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Initiatives for development of Hardware/Software industry including knowledge–based enterprises, measures for promoting IT exports and competitiveness of the industry."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "All matters relating to personnel under the control of the Ministry."
              },
              {
