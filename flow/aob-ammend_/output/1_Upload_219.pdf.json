            "content": [
              {
                "type": "department",
                "num": "C",
                "heading": "DEPARTMENT or BIO. TECHNOLOGY",
                "heading_hi": "BIOTECHNO. I OGY VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "To evolve integrated plans and programme ur biotechnology."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Identifying specific programmes of Research and Development and manufacturing in bio logicals and biotechnology and oversee the initiation and pursuit of related researcl and manufacturing activities."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Identify, set up and support centres 0 excellence for Research and Development in biotechnology and ensure proper dovetailing of these activities for activising the nationa priorities and objectives."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Act as a screening, advising and approvin agent of the Government, with regard to import and transfer of new technologie for the manufacture of biological and bio technological products and their inter mediates"
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Evolve safety guidelines for biotechnolog Research and Development and manufac turing in India."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "To act as the central agency for the import of genetically manipulated materials, culture, cells, speciments, tissues and biotech products including DNA and RNA of any type of size and for promoting their production in the country."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Serve as the interministerial and intergency nodal point for all specific international bilateral and multilateral Research and Development collaboration and agreement in the area of biotechnology and as the nodal point for all technology transters in the area of biotechnology."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Manufacture and applications of cell-based vacinnes."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "To evolve programmes of manpower development in the areas of biotechnology where there are gaps incompetence. FRINTED BY THE MANAGER, GOVT. OF"
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Serve as an administrative and implementing department of agencies, commissions boards, etc. specifically formed by the Government for fulfilling the national objectives in biotechnology and also to serve as the nodal voint for the collection and dissemination of information relating to biotechnology."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Work relating to the setting up of the International Centre for Genetic Engineering and Biotechnology."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Serve as the authorised department of the Government in respect of legislative and Parliamentary requirements in all areas mentioned under Allocation of Business for the Department."
              }
            ],
