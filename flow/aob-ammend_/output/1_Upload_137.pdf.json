            "scope": "children",
            "content": [
              {
                "type": "group_heading",
                "num": "I",
                "text": "General International Trade Policy"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "International Commercial Policy."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "International agencies principally connected with commercial policy (e.g., UNCTAD, ECAFE, ECA, ECIA, EEC, EFTA, GATT)."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "International Commodity Agreements other than agreements relating to Wheat."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "All matters relating to international trade policy including tariff and non-tariff barriers."
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "Foreign Trade"
              },
              {
                "type": "entry",
                "num": "5",
                "text": "All matters relating to foreign trade including trade negotiations and agreements (including General Agreement on Tariffs and Trade and Commonwealth Tariff Preferences), trade missions and delegations, trade cooperation and promotion and protection of interests of Indian traders abroad."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Import and Export Trade Policy and Control excluding the matters relating to"
              },
              {
                "type": "item",
                "num": "i",
                "text": "import of feature films"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "export of Indian films-both feature length and shorts; and"
              },
              {
                "type": "item",
                "num": "i",
                "text": "Import and distribution of cine-film (un-exposed) and other goods required by the film industry."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Chief Controller of Imports and Exports."
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "State Trading"
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Policies of State trading and performance of organisations established for the purpose, including:"
              },
              {
                "type": "item",
                "num": "i",
                "text": "State Trading Corporation and its subsidiaries, including:-"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Handlcrafts & Handlooms Export Corporation."
              },
              {
                "type": "item",
                "num": "b",
                "text": "Cashew Corporation of India."
              },
              {
                "type": "item",
                "num": "c",
                "text": "Projects & Equipment Corporation. (1) Minerals & Metals Trading Corporation."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "Trading with the enemy; Enemy property"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Trading with the enemy; enemy firms and enemy property; reparations (other than German Industrial equipment); Controller of Enemy Trading; Controller of Enemy Firms; Custodian of Enemy Properly for India."
              }
            ],
