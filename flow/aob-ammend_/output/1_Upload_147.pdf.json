            "content": [
              {
                "type": "ministry",
                "heading": "DEPARTMENT OF OFFICIAL LANGUAGE",
                "heading_hi": "RAJBHASHA VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Implementation of the provisions of the Constitution relating to Official Language and the provisions of the Official Languages Act 1983, except to the extent such implementation has been assigned to any other Department."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Prior approval of the President for authorising the limited use of a language other than English in the proceedings in the High Court of a State."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "All matters relating to the progressive use of Hindi for the official purposes of the Union."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Coordination of the work relating to Official Language being done by the various Ministries / Departments in the context of the provisiona of the Constitution, the Presidential Order of 27th April, 1960, the Official Languages Act, 1963 and the Government Resolution on Language dated 18th January, 1968."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Hindi Teaching Scheme for the Central Government Employees."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Matters relating to Kendriya Hindi Samiti."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Coordination of work relating to the Hindi Salahakar Samitis set up by the various Ministries / Departments."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Matters relating to the Central Translation Bureau."
              }
            ],
