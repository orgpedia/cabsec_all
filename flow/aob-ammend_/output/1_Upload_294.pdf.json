            "content": [
              {
                "type": "entry",
                "num": "17",
                "text": "Bharat Sanchar Nigam Limited."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Mahanagar Telephone Nigam Limited, Videsh Sanchar Nigam Limited and Telecommunicaitons Consultants (India) Limited."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "All matters relating to Centre for Development of Telematics (C-DOT)."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Residual work relating to the erstwhile Department of Telecom Services and Department of Telecom Operations including matters relating to the following:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "cadre control functions of Group 'A' and other categories of personnel till their absorption in Bharat Sanchar Nigam Limited"
              },
              {
                "type": "item",
                "num": "b",
                "text": "administration and payment of terminal benefits."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Execution of works purchase and acquisition of land debitable to the capital Budget pertaining to telecommunications."
              }
            ],
