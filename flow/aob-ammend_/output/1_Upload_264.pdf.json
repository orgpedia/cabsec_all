            "content": [
              {
                "type": "entry",
                "num": "14",
                "text": "Human Rights -"
              },
              {
                "type": "item",
                "num": "i",
                "text": "to act as nodal agency for the general policy regarding \"Human Rights\" matters, including National Human Rights Commistion, or any other in fitutional arrangements in this regard"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "human rights violations relating to alleged excesses by personnel of police and paramilitary forces"
              },
              {
                "type": "note",
                "text": "Note The preservation of human rights and policy issues relating thereto involving specific groups like members of Scheduled Castes and Scheduled Tribes, wome:, minorities, children, bonded labour, etc., will be the responsibility of the concerned Ministries Departments"
              },
              {
                "type": "item",
                "num": "iii",
                "text": "inction with Human Rights and other related organisations within the country and coordination with various Ministries and State Governments"
              },
              {
                "type": "item",
                "num": "iv",
                "text": "interaction with Human Rights organisations abroad"
              },
              {
                "type": "item",
                "num": "v",
                "text": "International Declarations, Treaties, Conventions and Conferences references received from the United Nations and other specialised agencies and organisations thereof and Coordination in respect thereof."
              }
            ],
