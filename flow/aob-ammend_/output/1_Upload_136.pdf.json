            "content": [
              {
                "type": "group_heading",
                "num": "E",
                "text": "DEPARTMESNT OF AGRICULTURAL RESEARCH AND EDUCA- TION (KRISHI ANUSANDHAN AUR SHIKSHA VIBHAG)"
              },
              {
                "type": "part",
                "num": "I",
                "heading": "PART I",
                "text": "The following subjects which fall within List I of the Seventh Schedule to the Constitution of India-"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Relations with foreign and international agricultural research and educational institutions and organisations, including participation in international conferences associations and other bodies dealing with agricultural research and education and tollow-up of decisions at such international conferences. etc."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Fundamental applied and operational research and higher education including coordination of such recarch and higher education in agriculture. animal husbandry, dairying and fisheries, including agricultural statistics, economies and marketing."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Co-ordination and determination of standards in institutions for higher education or research and scientific end technical institutions insofar as relates to food and agriculture includir a dry, dairying and fisheries."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Cases for financing the Indian Council of Agricultural Research, and the Commodity Research programmes other than those relating to tea, coffee and rubber."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Sugarcane research."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II",
                "text": "The following subjects which fall within List III of the Seventh Schedule to the Constitution of India (as regards legislation only):-"
              },
              {
                "type": "part",
                "num": "III",
                "heading": "PART III",
                "text": "For Union Territories the subjects mentioned in Part I above, so far as they exist in regard to these Territories and in addition the following subject which falls within List II of the Seventh Schedule to the Constitution of India:-"
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Agricultural Education and Research. SEC. 3(ii) 1"
              },
              {
                "type": "part",
                "num": "IV",
                "heading": "PART IV",
                "text": "General and Consequential:--"
              },
              {
                "type": "entry",
                "num": "7",
                "text": "All matters relating to foreign aid received from foreign countries and International Organisations insofar as agricultural research and education and allied subjects are concerned, including all matters relating to assistance afforded by India to foreign countries in the field of Agricultural research and education and allied subjects."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Plant introduction and exploration."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "All India Soil and Land Use Survey relating to research, training, co-relation classification, soil :mapping and interpretation."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Financial assistance to State Governmen's and Agricultural Universities in respect of agricultural research and educational schemes and programmes."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "National Demonstrations."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Indian Council of Agricultural Research and its constituent Research Institutes, Stations, Laboratories and Centres."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Offences against laws with respect to any of the subjects allotted to this Department."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Inquiries and statistics for the purposes of any of the subjects allotted to this Department."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Fees in respect of any of the subjects allotted to this Department except fees taken in a court."
              }
            ],
