            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF PORTS, SHIPPING AND WATERWAYS",
                "heading_hi": "PATTAN, POT PARIVAHAN AUR JALMARG MANTRALAYA"
              },
              {
                "type": "group_heading",
                "num": "I",
                "text": "THE FOLLOWING SUBJECTS WHICH FALL WITHIN LIST 1 OF THE SEVENTH SCHEDULE TO THE CONSTITUTION OF INDIA:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Maritime shipping and navigation; provision of education and training for the mercantile marine."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Lighthouses and lightships."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Administration of the Indian Ports Act, 1908 (15 of 1908) and the Major Port Trusts Act, 1963 (38 of 1963) and ports declared as major ports."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Shipping and navigation including carriage of passengers and goods on inland waterways declared by Parliament by law to be national waterways as regards mechanically propelled vessels, the rule of the road on such waterways."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Ship-building and ship-repair industry."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Ship breaking."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Fishing vessels industry."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Floating craft industry."
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "IN RESPECT OF THE UNION TERRITORIES:"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Inland waterways and traffic thereon."
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "IN RESPECT OF THE UNION TERRITORIES OF THE ANDAMAN AND NICOBAR ISLANDS AND THE LAKSHADWEEP:"
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Organisation and maintenance of mainland islands and inter-island shipping services."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "OTHER SUBJECTS WHICH HAVE NOT BEEN INCLUDED UNDER THE PREVIOUS PARTS:"
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Legislation relating to shipping and navigation on inland waterways as regards mechanically propelled vessels and the carriage of passengers and goods on inland waterways."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Legislation relating to and coordination of the development of minor and major ports."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Administration of the Dock Workers (Regulation of Employment) Act, 1948 (9 of 1948) and the Schemes framed thereunder other than the Dock Workers (Safety, Health and Welfare) Scheme, 1961."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "To make shipping arrangements for and on behalf of the Government of India/Public Sector Undertakings/State Governments/ State Government Public Sector Undertakings and autonomous bodies in respect of import of cargo on Free on Board/Free along Site and export on Cost and Freight/Cost Insurance and Freight basis."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Planning of Inland Water Transport."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Formulation of the privatization policy in the infrastructure areas of ports, shipping and inland waterways."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "The Development of township of Gandhidham."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Prevention and control of pollution:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Prevention and control of pollution arising from ships, shipwrecks and abandoned ships in the sea including the port areas"
              },
              {
                "type": "item",
                "num": "b",
                "text": "enactment and administration of legislation related to prevention, control and combating of pollution arising from ships; and"
              },
              {
                "type": "item",
                "num": "c",
                "text": "monitoring and combating of oil pollution in the port areas."
              },
              {
                "type": "group_heading",
                "num": "V",
                "text": "SUBORDINATE OFFICES:"
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Directorate General of Shipping."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Andaman Lakshadweep Harbour Works."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Directorate General of Lighthouses and Lightships."
              },
              {
                "type": "entry",
                "num": "22",
                "text": "Minor Ports Survey Organisation."
              },
              {
                "type": "group_heading",
                "num": "VI",
                "text": "AUTONOMOUS BODIES:"
              },
              {
                "type": "entry",
                "num": "23",
                "text": "Tariff Authority for Major Ports (TAMP)."
              },
              {
                "type": "entry",
                "num": "24",
                "text": "Port Trusts at Mumbai, Kolkata, Kochi, Kandla, Chennai, Mormugao, Jawahar Lal Nehru (Nhava Sheva), Paradip, Tuticorin, Visakhapatnam and New Mangalore."
              },
              {
                "type": "entry",
                "num": "25",
                "text": "Dock Labour Boards at Kolkata, Kandla and Visakhapatnam."
              },
              {
                "type": "entry",
                "num": "26",
                "text": "Inland Waterways Authority of India."
              },
              {
                "type": "entry",
                "num": "27",
                "text": "Seamen's Provident Fund Organisation."
              },
              {
                "type": "group_heading",
                "num": "VII",
                "text": "SOCIETIES/ASSOCIATIONS:"
              },
              {
                "type": "entry",
                "num": "28",
                "text": "National Institute of Port Management."
              },
              {
                "type": "entry",
                "num": "29",
                "text": "National Ship Design and Research Centre."
              },
              {
                "type": "entry",
                "num": "30",
                "text": "Seafarers Welfare Fund Society."
              },
              {
                "type": "group_heading",
                "num": "VIII",
                "text": "PUBLIC SECTOR UNDERTAKINGS:"
              },
              {
                "type": "entry",
                "num": "31",
                "text": "Shipping Corporation of India."
              },
              {
                "type": "entry",
                "num": "32",
                "text": "Cochin Shipyard Limited."
              },
              {
                "type": "entry",
                "num": "33",
                "text": "Central Inland Water Transport Corporation Limited."
              },
              {
                "type": "entry",
                "num": "34",
                "text": "Dredging Corporation of India."
              },
              {
                "type": "entry",
                "num": "35",
                "text": "Hooghly Dock and Ports Engineers Limited."
              },
              {
                "type": "entry",
                "num": "36",
                "text": "Ennore Port Limited."
              },
              {
                "type": "group_heading",
                "num": "IX",
                "text": "INTERNATIONAL ASPECTS:"
              },
              {
                "type": "entry",
                "num": "37",
                "text": "International Maritime Organisation."
              },
              {
                "type": "group_heading",
                "num": "X",
                "text": "ACTS:"
              },
              {
                "type": "entry",
                "num": "38",
                "text": "The Indian Ports Act, 1908 (15 of 1908)."
              },
              {
                "type": "entry",
                "num": "39",
                "text": "The Inland Vessels Act, 1917 (1 of 1917)."
              },
              {
                "type": "entry",
                "num": "40",
                "text": "The Dock Workers (Regulation of Employment) Act, 1948 (9 of 1948)."
              },
              {
                "type": "entry",
                "num": "41",
                "text": "The Merchant Shipping Act, 1958 (44 of 1958)."
              },
              {
                "type": "entry",
                "num": "42",
                "text": "The Major Port Trusts Act, 1963 (38 of 1963)."
              },
              {
                "type": "entry",
                "num": "43",
                "text": "The Seamen's Provident Fund Act, 1966 (4 of 1966)."
              },
              {
                "type": "entry",
                "num": "44",
                "text": "The Inland Waterways Authority of India Act, 1985 (82 of 1985)."
              },
              {
                "type": "entry",
                "num": "45",
                "text": "The Multimodal Transportation of Goods Act, 1993 (28 of 1993)."
              }
            ],
