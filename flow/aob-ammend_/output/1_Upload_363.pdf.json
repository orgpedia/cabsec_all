            "content": [
              {
                "type": "part",
                "num": "V",
                "heading": "PART V"
              },
              {
                "type": "entry",
                "num": "55",
                "text": "Matters relating to damage to crops and co-ordination of relief measures necessitated by drought, hailstorm and pest-attacks, cold wave and frost."
              },
              {
                "type": "entry",
                "num": "56",
                "text": "Matters relating to loss of human life due to drought."
              },
              {
                "type": "entry",
                "num": "57",
                "text": "Agricultural credit and indebtedness."
              },
              {
                "type": "entry",
                "num": "58",
                "text": "Crop Insurance."
              },
              {
                "type": "entry",
                "num": "59",
                "text": "Crop campaigns, crop competitions and farmers organisations including Farmer Producer Organisations."
              },
              {
                "type": "entry",
                "num": "60",
                "text": "Agricultural Schemes received from States and Union Territories for landless agricultural labour."
              },
              {
                "type": "entry",
                "num": "61",
                "text": "Setting up of agricultural markets in rural areas."
              },
              {
                "type": "entry",
                "num": "62",
                "text": "Warehousing in rural areas including rural godowns."
              },
              {
                "type": "entry",
                "num": "63",
                "text": "Schemes for welfare of farmers."
              }
            ],
