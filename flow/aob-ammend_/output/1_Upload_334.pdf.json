            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF MICRO, SMALL AND MEDIUM ENTERPRISES",
                "heading_hi": "SUKSHMA LAGHU AUR MADHYAM UDYAM MANTRALAYA"
              },
              {
                "type": "part",
                "num": "I",
                "heading": "PART I",
                "text": "Subjects in List I of the Seventh Schedule to the Constitution of India:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Industries, the development and regulation of which by the Union are declared by Parliament to be expedient in public interest under the Industries (Development and Regulation) Act 1951 (65 of 1951) and the Micro, Small and Medium Enterprises Development Act, 2006 (27 of 2006) so far as they relate respectively to small scale industrial undertakings and ancillary industrial undertakings and, as the case may be, micro, small and medium enterprises defined in the said Acts."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II"
              },
              {
                "type": "entry",
                "num": "2",
                "text": "For the Union Territories, the subject mentioned in PART 1 above so far as they exist in regard to these territories."
              },
              {
                "type": "part",
                "num": "III",
                "heading": "PART III",
                "text": "General and Consequential:"
              },
              {
                "type": "entry",
                "num": "3",
                "text": "All matters of policy and planning relating to and coordination of all measures for development of micro, small and medium enterprises, including khadi, cottage, village and coir industries."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "National Board for Micro, Small and Medium Enterprises."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Co-operation in the micro, small and medium enterprises sector, including cottage, khadi village and coir industries, excepting cooperative sugar factories."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "All matters relating to preference policies for procurement of goods produced and services. rendered by micro and small enterprises by Ministries or Departments, public sector undertakings and aided institutions of the Central Government."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "All matters relating to technical and economic cooperation with the United Nations Industrial Development Organisation for promotion and development of micro, small and medium enterprises, including cottage, khadi, village and coir industries."
              },
              {
                "type": "part",
                "num": "IV",
                "heading": "PART IV",
                "text": "Attached Office:"
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Small Industries Development Organisation (SIDO) and Office of the Development Commissioner (Small Scale Industries), including Small Industries Development Organisation field units like Small Industry Service Institutes, Regional Testing Centres and Field Testing Stations, Small Entrepreneurs Promotion and Training Institute (SEPTI), etc."
              },
              {
                "type": "part",
                "num": "V",
                "heading": "PART V",
                "text": "Statutory and Autonomous Bodies and Training Institutes:"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Khadi and Village Industries Commission (KVIC), Mumbai."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Coir Board (CB), Kochi."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Tool Rooms and Training Centres operated through the Small Industries Development Organisation."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Entrepreneurship Development and Skill Development or Training Institutes:"
              },
              {
                "type": "item",
                "num": "i",
                "text": "National Institute of Small Industry Extension Training (NISIET), Hyderabad."
              },
              {
                "type": "item",
                "num": "ii",
                "text": "National Institute for Entrepreneurship and Small Business Development (NIESBUD) NOIDA."
              },
              {
                "type": "item",
                "num": "iii",
                "text": "Indian Institute of Entrepreneurship (IIE), Guwahati."
              },
              {
                "type": "item",
                "num": "iv",
                "text": "Central Footwear Training Institute (CFTI), Agra."
              },
              {
                "type": "item",
                "num": "v",
                "text": "Central Footwear Training Institute (CFTI), Chennai."
              },
              {
                "type": "item",
                "num": "vi",
                "text": "All Training Institutes of Khadi and Village Industries Commission."
              },
              {
                "type": "item",
                "num": "vii",
                "text": "All Training Institutes of Coir Board"
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Credit Guarantee Fund Trust for Small Industries."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Research and Development Centres, including: 1 (1) Institute for Design of Electrical Measuring Instruments (IDEMI), Mumbai."
              },
              {
                "type": "item",
                "num": "ii",
                "text": "Electronic Service and Training Centre (ESTC), Ramnagar."
              },
              {
                "type": "item",
                "num": "iii",
                "text": "Process and Product Development Centre (PPDC), Agra."
              },
              {
                "type": "item",
                "num": "iv",
                "text": "Process and Product Development Centre (PPDC), Meerut."
              },
              {
                "type": "item",
                "num": "v",
                "text": "Fragrance and Flavour Development Centre (FFDC), Kannauj."
              },
              {
                "type": "item",
                "num": "vi",
                "text": "Centre for the Development of Glass Industry (CDGI), Firozabad."
              },
              {
                "type": "item",
                "num": "vii",
                "text": "Mahatma Gandhi Institute of Rural Industrialisation, Wardha."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Any other statutory body or institute created for Micro, Small and Medium Enterprises including those in the unorganised sector. 238795/07-2"
              },
              {
                "type": "part",
                "num": "VI",
                "heading": "PART VI",
                "text": "Public Sector Undertaking:"
              },
              {
                "type": "entry",
                "num": "16",
                "text": "National Small Industries Corporation Limited, Delhi."
              },
              {
                "type": "part",
                "num": "VII",
                "heading": "PART VII",
                "text": "Awards and Exhibitions:"
              },
              {
                "type": "entry",
                "num": "17",
                "text": "National Awards for Micro, Small and Medium Enterprises, including khadi, cottage, village and coir industries."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "National Awards for Research and Development Efforts by Micro, Small and Medium Enterprises, including khadi, cottage, village and coir industries."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "National Awards for Quality Products, including khadi, cottage, village and coir industries."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "National and international exhibitions, buyer-seller meets and similar events for promotion and development of micro, small and medium enterprises, including khadi, cottage, village and coir industries. PART VIHI Administration of Acts, Rules and Regulations:"
              },
              {
                "type": "entry",
                "num": "21",
                "text": "The Micro, Small and Medium Enterprises Development Act, 2006 (27 of 2006) and Rules and Regulations thereunder."
              },
              {
                "type": "entry",
                "num": "22",
                "text": "Section 29B of the Industries (Development and Regulation) Act, 1951 (65 of 1951) to the extent its provisions relate to small scale industrial undertakings and ancillary industrial undertakings and Rules and Regulations thereunder."
              },
              {
                "type": "entry",
                "num": "23",
                "text": "The Khadi and Village Industries Commission Act, 1956 (61 of 1956) and Rules and Regulations thereunder."
              },
              {
                "type": "entry",
                "num": "24",
                "text": "The Coir Industry Act, 1953 (45 of 1953) and Rules and Regulations thereunder."
              },
              {
                "type": "part",
                "num": "IX",
                "heading": "PART IX",
                "text": "Miscellaneous:"
              },
              {
                "type": "entry",
                "num": "25",
                "text": "Coordination and implementation of Prime Minister's Rozgar Yojana and Rural Employment Generation Programme and similar schemes or programmes relating to industrialisation and employment generation through promotion and development of micro, small and medium enterprises, including khadi, cottage, village and coir industries with the States or Union territories, and enhancing the competitiveness of such enterprises and industries."
              },
              {
                "type": "entry",
                "num": "26",
                "text": "All other matters relating to micro, small, medium enterprises including khadi, cottage, village and coir industries, not specifically allocated to any other Ministry or Department and renomenclature of the existing non-statutory organisations, field offices and institutions under the Ministry in line with the Micro, Small and Medium Enterprises Development Act, 2006 (27 of 2006)"
              }
            ],
