            "content": [
              {
                "type": "entry",
                "num": "1",
                "text": "Formulation of policy and policy issues for development and propagation of Traditional & Non-Conventional Systems of Health Care and Healing which include Ayurveda, Yoga Naturopathy, Unani, Siddha, Sowa Rigpa and Homoeopathy etc. (Ayush systems of Health Care)."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Development and implementation of programmes including Central schemes and Centrally sponsored schemes for development and propagation of Ayush systems of Health Care."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Co-ordination and promotion of research and development including assistance therefor in Ayush systems of Health Care."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Setting up and maintenance of Central institutions for research and development, education and standards relating to Ayush systems of Health Care."
              }
            ],
