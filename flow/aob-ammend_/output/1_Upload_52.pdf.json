            "expect": "Ministry of Transport and Communications",
            "content": [
              {
                "type": "text",
                "text": "MĮNISTRY OF TRANSPORT"
              },
              {
                "type": "group_heading",
                "num": "I",
                "text": "The following subjects which fall within List I of the Seventh Schedule to the Constitution of India:- ---"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Maritime shipping and navigation; provision of education and training for the mercantile marine."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Lighthouses and lightships."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Major ports i.e., the ports of Calcutta, Bombay, Madras, Visakhapatnam Cochin and Kandſa."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Compulsory insurance of motor vehicles."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Administration of the Road Transport Corporation Act, 1950."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Highways declared by or under law made by Parliament to be national highways."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Shipping and navigation including carriage of passengers and goods on inland waterways declared by Parliament by law to be National waterways as regards mechanically propelled vessels; the rule of the road on such waterways."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Ship building (Public sector)."
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "In respect of the Union Territories:—"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Roads other than national highways."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Tramways within municipal limits."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Inland waterways and traffic thereon."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Administration of the Motor Vehicles Act, 1939, and taxation of motor vehicles."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Vehicles other than mechanically propelled vehicles."
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "Other subjects not included under the preceding headings:—"
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Central Road Fund."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Coordination and research pertaining to road works."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Road works financed in whole or in part by the Central Government including road works in Sikkim and the tribal arcas of Assam specified in parts A and B of the table appended to para 20 of the Sixth Schedule to the Constitution."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Motor vehicles legislation."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Legislation relating to shipping and navigation on inland waterways as regards mechanically propelled vessels and the carriage of passengers and goods on inland waterways."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Tourist traffic development."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Planning of road and inland waterways transport."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Promotion of Transport Cooperative in the field of motor transport and inland water transport."
              },
              {
                "type": "entry",
                "num": "22",
                "text": "Development of township of Gandhidham."
              },
              {
                "type": "entry",
                "num": "23",
                "text": "Legislation relating to and co-ordination of the development of minor ports. SEC. $ (ii)]"
              },
              {
                "type": "entry",
                "num": "24",
                "text": "Centralised arrangements for the servicing and repairs of staff cars belonging to the Central Government except those under the control and use of the Ministry of Railways and the Department of Atomic Energy."
              },
              {
                "type": "entry",
                "num": "25",
                "text": "Implementation of treaties and agreements relating to matters specified in entries 26 to 30 below."
              },
              {
                "type": "entry",
                "num": "26",
                "text": "Meteorological Organisation."
              },
              {
                "type": "entry",
                "num": "27",
                "text": "Aircraft and air navigation; provision of aerodromes; regulation and organisation of air traffic and of aerodromes (excepting sanitary control of air navigation)."
              },
              {
                "type": "entry",
                "num": "28",
                "text": "Beacons and other provisions for the safety of aircraft."
              },
              {
                "type": "entry",
                "num": "29",
                "text": "Carrlage of passengers and goods by air."
              },
              {
                "type": "entry",
                "num": "30",
                "text": "Corporations established under the Air Corporations Act, 1953."
              },
              {
                "type": "entry",
                "num": "31",
                "text": "Offences against laws with respect to any of the matters specified in entries 26 to 30 above."
              },
              {
                "type": "entry",
                "num": "32",
                "text": "Inquiries and statistics for the purpose of any of the matters specified in entries 26 to 30 above."
              },
              {
                "type": "entry",
                "num": "33",
                "text": "Fees in respect of any of the matters specified in entries 26 to 30 above but not including fees taken in any court."
              },
              {
                "type": "entry",
                "num": "34",
                "text": "Railway Inspectorate."
              }
            ],
