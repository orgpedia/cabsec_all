            "content": [
              {
                "type": "entry",
                "num": "1",
                "text": "Earth Commission and all matters relating thereto."
              },
              {
                "type": "entry",
                "num": "2",
                "text": ""
              },
              {
                "type": "item",
                "num": "a",
                "text": "(i) Matters of policy, coordination and schemes relating to the Ocean, Atmospheric and Meteorological Sciences, Seismology and Solid Earth, Polar Science and Earth System Sciences, not specifically allocated to any other Department or Ministry"
              },
              {
                "type": "item",
                "num": "ii",
                "text": "research (including fundamental research) related to Earth System Sciences and the development of uses relatable thereto"
              },
              {
                "type": "item",
                "num": "iii",
                "text": "technology development"
              },
              {
                "type": "item",
                "num": "iv",
                "text": "surveys to map, locate and assess living and non-living marine resources"
              },
              {
                "type": "item",
                "num": "v",
                "text": "preservation, conservation and protection of marine and polar resources"
              },
              {
                "type": "item",
                "num": "vi",
                "text": "development of appropriate skills and manpower"
              },
              {
                "type": "item",
                "num": "vii",
                "text": "international collaboration and cooperation"
              },
              {
                "type": "item",
                "num": "b",
                "text": "laws and regulatory measures relating to the above."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Marine Environment on the high seas."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Earth System Science Oganisation (ESSO)."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Earth System Science and Technology Agency or Board."
              }
