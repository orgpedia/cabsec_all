            "content": [
              {
                "type": "rule",
                "num": "3",
                "text": "Distribution of subjects"
              },
              {
                "type": "sub_rule",
                "num": "1",
                "text": "The distribution of subjects among the departments shall be as specified in the Second Schedule to these Rules and sub-rule (2) of this rule."
              },
              {
                "type": "sub_rule",
                "num": "2",
                "text": "The compiling of the accounts of each Department shall stand allocated to that Department with effect from the date from which the President relieves. by order made under the first proviso to sub-section (1) of section 10 of the Comptroller and Auditor General's (Duties, Powers and Conditions of Service) Act, 1971, the Comptroller and Auditor General from the responsibility for compiling the accounts of that Department."
              }
            ],
