              },
              {
                "type": "department",
                "num": "A",
                "heading": "DEPARTMENT OF WELFARE",
                "heading_hi": "KALYAN VIBHAG"
              },
              {
                "type": "part",
                "num": "I",
                "heading": "PART I",
                "text": "The following subjects which fall within List I of the Seventh Schedule to the Constitution of India :"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Operation of Indo-US, Indo-UK, Indo-German, Indo-Swiss and Indo-Swedish Agreements for duty free receipt of donated relief supplies goods and matters connected with the distribution of supplies coming thereunder."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II",
                "text": "The following subject which falls within List I of the Seventh Schedule to the Constitution of India (as regards legislation only) :"
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Social Security and Social Insurance save to the extent allotted to any other Department."
              },
              {
                "type": "part",
                "num": "III",
                "heading": "PART III",
                "text": "For the Union territories, the following subicct which falls within Liſt II or List III of the Seventh Schedule to the Constitution of India, in so far as it exits in regard to such territories :"
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Relief of the disabled and unemployable and measures relating to social security and social Insurance, save to the extent allotted to any other Department."
              },
              {
                "type": "part",
                "num": "IV",
                "heading": "PART IV",
                "text": "GENERAL AND CONSEQUENTIAL."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Social Welfare: Social Welfare Planning Proiect formulation, research, evaluation. statistics and training."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Conventions with other countries in maiters relating to social defence and references from United Nations Organisation 10- lating to prevention of crime and treatment of offenders 1173 GT/90-2"
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Institutional and non-institutional services for the care and development of children in need including orphans and orphanages."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Education, training, rehabilitation and welfare of the physically and mentally handicapped."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "National Institute for the Physically Handicapped and Mentally Retarded."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "National Centre for the Blind including the Central Braille Press, Dehra Dun, Training Centre for the Adult Deaf, and School for the partially deaf children, Hyderabad Modei School for Mentally Retarded Children, New Delhi and other national in,- titutes."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Social and Moral Hygiene Programme. 11, Beggary, Juvenile vagrancy, delinquency and other CARE Programmes."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Probation of Juvenile offenders."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Research, evaluation, training, exchange of information and technical guidance on all social defence matters, including correctional services."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "All matters relating to prohibition."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Educational and social welfare aspects of drug addiction."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Charitable and religious endowments pertaining to subjects allocated to this Department."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Promotion and development of voluntary effort on subjects allocated to this Department."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "National Institute of Social Defence."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Artificial Limbs Manufacturing Corporation of India, Kanpur (ALIMCO)."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "All other attached or Subordinate Offices or other organisations concerned with any of the subjects specified in this list."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Administration of the following Acts -"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Probation of Offenders Act, 1958 (20 of 1958); and"
              },
              {
