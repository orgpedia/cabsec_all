              ]
            },
            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF COOPERATION",
                "heading_hi": "SAHKARITA MANTRALAYA"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "General Policy in the field of Co-operation and Co-ordination of co-operation activities in all sectors."
              },
              {
                "type": "note",
                "text": "Note: - The Ministries concerned are responsible for Co-operatives in the respective fields."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Realisation of vision “from cooperation to prosperity”."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Strengthening of cooperative movement in the country and deepening its reach up to the grassroots."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Promotion of cooperative-based economic development model, including the spirit of responsibility among its members to develop the country."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Creation of appropriate policy, legal and institutional framework to help cooperatives realise their potential."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Matters relating to National Co-operative Organisation."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "National Co-operative Development Corporation."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Incorporation, regulation and winding up of Co-operative societies with objects not confined to one State including administration of „the Multi-State Co-operative Societies Act, 2002 (39 of 2002)‟:"
              },
              {
                "type": "proviso",
                "text": "Provided that the administrative Ministry or Department shall be „the Central Government‟ for the purpose of exercising powers under the Multi-State Co-operative Societies Act, 2002 (39 of 2002), for Co-operative units functioning under its control."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Training of personnel of co-operative departments and co-operative institutions (including education of members, office bearers and non-officials)."
              }
            ],
