            "content": [
              {
                "type": "ministry",
                "heading": "Ministry of Surface Transport",
                "heading_hi": "Jal-Bhootal Pariwahan Mantralaya"
              },
              {
                "type": "group_heading",
                "num": "I",
                "text": "The following subjects will fall within list I of the 7th Schedule to the Constitution of India :"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Maritime shipping and navigation; provision of education and training for the merchantile marine."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Lighthouses and lightships."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Administration of the Indian Ports Act. 1908 (15 of 1908) and ports declared as major ports."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Compulsory insurance of notor vehicles."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Administration of the Road Transport Corporations Act, 1950 (64 of 1950)."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Highways declared by or under law made by Parliament to be national highways."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Shipping and navigation including carriage of passengers and goods on inland waterways declared by Parliament by law to be national waterways as regards mechanically propelled vessels, the rule of the road on such waterways."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Ship-building and Ship-repair industry."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Fishing vessels Industry."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Floating craft industry."
              },
              {
                "type": "group_heading",
                "num": "IJ",
                "text": "In respect of the Union Territories:"
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Roads other than National Highways.."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Tramways within municipal limits."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Inland waterways and traffic thereon."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Administration of the Motor Vehicles Act, 1 1939 (4 of 1939) and taxation of motor vehicles."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Vehicles other than mechanically propelled vehicles."
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "In respect of the Union territories of the Anda-/ man and Nicobar and Lakshadweep Islands: ।"
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Organisation and maintenance of mainand islands and inter-island shipping services."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "Other subjects which have not been included under the previous sub-heads :"
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Central Road Fund."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Coordination and Research pertaining to Road Works."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Road works financed in whole or in part by the Central Government other than rural roads and the road works in the tribal areas of Assam specified in Parts I and II of the Table appended to paragraph 20 of the Sixth Schedule to the Constitution."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Motor vehicles legislation."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Legislation relating to shipping and navigation on inland waterways as regar's mechanically propelled vessels and the carriage of passengers and goods on inland waterways."
              },
              {
                "type": "entry",
                "num": "22",
                "text": "Planning of Road and inland waterways Transport."
              },
              {
                "type": "entry",
                "num": "23",
                "text": "Promotion of Transport Cooperatives in the field of motor transport and inland water transport."
              },
              {
                "type": "entry",
                "num": "24",
                "text": "Development of townships of Gandhidham."
              },
              {
                "type": "entry",
                "num": "25",
                "text": "Legislation relating to and co-ordination of the development of minor ports."
              },
