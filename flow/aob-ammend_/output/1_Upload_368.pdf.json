            "expect": "D. DEPARTMENT OF DISINVESTMENT (VINIVESH VIBHAG)",
            "content": [
              {
                "type": "department",
                "num": "D",
                "heading": "DEPARTMENT OF INVESTMENT AND PUBLIC ASSET MANAGEMENT (DIPAM)",
                "heading_hi": "NIVESH AUR LOK PARISAMPATTI PRABANDHAN VIBHAG (DIPAM)"
              },
              {
                "type": "entry",
                "num": "1",
                "text": ""
              },
              {
                "type": "item",
                "num": "a",
                "text": "All matters relating to management of Central Government investments in equity including disinvestment of equity in Central Public Sector Undertakings."
              },
              {
                "type": "item",
                "num": "b",
                "text": "All matters relating to sale of Central Government equity through offer for sale or private placement or any other mode in the erstwhile Central Public Sector Undertakings."
              },
              {
                "type": "note",
                "text": "Note:- All other post disinvestment matters, including those relating to and arising out of the exercise of Call option by the Strategic Partner in the erstwhile Central Public Sector Undertakings, shall continue to be handled by the administrative Ministry or Department concerned, where necessary, in consultation with the Department of Investment and Public Asset Management (DIPAM)."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Decisions on the recommendations of Administrative Ministries, NITI Aayog, etc. for disinvestment including strategic disinvestment."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "All matters related to Independent External Monitor(s) for disinvestment and public asset management."
              },
              {
                "type": "entry",
                "num": "4",
                "text": ""
              },
              {
                "type": "item",
                "num": "a",
                "text": "Decisions in matters relating to Central Public Sector Undertakings for purposes of Government investment in equity like capital restructuring, bonus, dividends disinvestment of government equity and other related issues."
              },
              {
                "type": "item",
                "num": "b",
                "text": "Advise the Government in the matters of financial restructuring of Central Public Sector Enterprises and for attracting investment through capital markets."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Financial policy in regard to the utilisation of the proceeds of disinvestment channelised into the National Investment Fund."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "The Unit Trust of India Act, 1963 (52 of 1963) along with subjects relating to Specified Undertaking of the Unit Trust of India (SUUTI)."
              }
            ],
