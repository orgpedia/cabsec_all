            "content": [
              {
                "type": "department",
                "num": "AA",
                "heading": "DEPARTMENT OF MILITARY AFFAIRS",
                "heading_hi": "SAINYA KARYA VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "The Armed Forces of the Union, namely, Army, Navy and Air Force."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Integrated Headquarters of the Ministry of Defence comprising of Army Headquarters Naval Headquarters, Air Headquarters and Defence Staff Headquarters."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "The Territorial Army."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Works relating to Army, Navy and Air Force."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Procurement exclusive to the Services except capital acquisitions, as per prevalent rules and procedures."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Promoting jointness in procurement, training and staffing for the Services through joint planning and integration of their requirements."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Facilitation of restructuring of Military Commands for optimal utilisation of resources by bringing about jointness in operations, including through establishment of joint/ theatre commands."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Promoting use of indigenous equipment by the Services."
              }
            ],
