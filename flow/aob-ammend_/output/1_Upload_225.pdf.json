            "content": [
              {
                "type": "text",
                "text": "(3) Where sanction for the prosecution of any person for any offence is required to be accorded-"
              },
              {
                "type": "sub_rule",
                "num": "a",
                "text": "If he is a Government servant, by the Department which is the Cadre Controlling authority for the service of which he is a member, and in any other case, by the Depatment in which he was working at the time of commission of the alleged offence; and"
              },
              {
                "type": "sub_rule",
                "num": "b",
                "text": "If he is a public servant other than a Government servant, appointed by the Central Government, by the Department administratively concerned with the orgaisation in which he was working at the Hac commission of the alleged offence; a"
              },
              {
                "type": "sub_rule",
                "num": "c",
                "text": "In any other case, by the Department which administers the Act under which alleged offence is committed:"
              },
              {
                "type": "proviso",
                "text": "Provided that where, for offences alleged to have been committed, sanction is required under more than one Act, it shall be compelent for the Department which administers any of such Acts to accord sanction under all such Acts. (4) Notwithstanding anything contained in subrule (3) the President may, by general or special order, direct that in any case or class of cases the sanction shall be accorded by the Department of Personnel and Training."
              }
            ],
