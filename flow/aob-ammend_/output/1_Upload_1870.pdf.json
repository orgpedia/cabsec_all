            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF FISHERIES, ANIMAL HUSBANDRY AND DAIRYING",
                "heading_hi": "MATSYAPALAN PASHUPALAN AUR DAIRY MANTRYALAYA"
              },
              {
                "type": "department",
                "num": "A",
                "heading": "DEPARTMENT OF FISHERIES",
                "heading_hi": "MATSYAPALAN VIBHAG"
              },
              {
                "type": "part",
                "num": "I",
                "heading": "PART I",
                "text": "The following subjects which fall within List I of the Seventh Schedule to the Constitution of India:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Industries, the control of which by the Union is declared by Parliament by law to be expedient in public interest as far as these relate to development of fish feed and fish products with the limitation that in regard to the development of industries, the functions of the Department of Fisheries do not go further than the formulation of the demand and fixation of targets."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Promotion and development of fishing and fisheries (inland, marine and beyond territorial waters) and its associated activities, including infrastructure development, marketing, exports, and institutional arrangements etc."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Welfare of fishermen and other fisher-folk and strengthening of their livelihoods."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Liaison and cooperation with international organizations in matters relating to fisheries development."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Fisheries Statistics."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Matters relating to loss of fish stock due to natural calamities."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Regulation of fish stock importation, quarantine and certification."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Fishery Survey of India, Mumbai."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II",
                "text": "The following subjects which fall within List III of the Seventh Schedule to the Constitution of India (as regards legislation only):"
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Prevention of the extension from one State to another of infectious or contagious diseases or pests affecting fish."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Pattern of financial assistance to various State Undertakings, Fisheries Development Schemes through State agencies/Co-operative Unions."
              },
              {
                "type": "part",
                "num": "III",
                "heading": "PART III",
                "text": "For the Union territories the subjects mentioned in parts I and II above, so far as they exist in regard to these territories and, in addition, to the following subjects which fall within List II of the Seventh Schedule to the Constitution of India:"
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Preservation, protection and improvement of fish stocks and prevention of diseases thereof veterinary training and practice."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Insurance of fish stock."
              },
              {
                "type": "department",
                "num": "B",
                "heading": "DEPARTMENT OF ANIMAL HUSBANDRY AND DAIRYING",
                "heading_hi": "PASHUPALAN AUR DAIRY VIBHAG"
              },
              {
                "type": "part",
                "num": "I",
                "heading": "PART I",
                "text": "The following subjects which fall within List I of the Seventh Schedule to the Constitution of India:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Industries, the control of which by the Union is declared by Parliament by law to be expedient in public interest as far as these relate to development of livestock and birds feed and dairy and poultry products with the limitation that in regard to the development of industries, the functions of the Department of Animal Husbandry and Dairying do not go further than the formulation of the demand and fixation of targets."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Promotion and development of livestock, dairy and poultry and its associated activities, including infrastructure development, marketing, exports and institutional arrangements etc."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Welfare of persons engaged in activities relating to livestock, dairy and poultry."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Liaison and cooperation with international organizations in matters relating to livestock and poultry development."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Livestock Census."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Livestock Statistics."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Matters relating to loss of livestock due to natural calamities."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Regulation of livestock importation, animal quarantine and certification."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Gaushalas and Gausadans."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Matters relating to pounds and cattle trespass."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Prevention of cruelty to animals."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "The Prevention of Cruelty to Animals Act, 1960 (59 of 1960)."
              },
              {
                "type": "part",
                "num": "II",
                "heading": "PART II",
                "text": "The following subjects which fall within List III of the Seventh Schedule to the Constitution of India (as regards legislation only):"
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Profession of veterinary practice."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Prevention of the extension from one State to another of infectious or contagious diseases or pests affecting animals and birds."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Conversion of indigenous breeds; introduction and maintenance of Central Herd Books for indigenous breeds of livestock."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Pattern of financial assistance to various State Undertakings, Dairy Development Schemes through State agencies/Co-operative Unions."
              },
              {
                "type": "part",
                "num": "III",
                "heading": "PART III",
                "text": "For the Union territories the subjects mentioned in parts I and II above, so far as they exist in regard to these territories and, in addition, to the following subjects which fall within List II of the Seventh Schedule to the Constitution of India:"
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Preservation, protection and improvement of stocks and prevention of diseases of animals and birds, veterinary training and practice."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Courts of Wards."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Insurance of livestock and birds."
              },
              {
                "type": "part",
                "num": "IV",
                "heading": "PART IV"
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Matters relating to cattle utilisation and slaughter."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "Fodder development."
              }
            ],
