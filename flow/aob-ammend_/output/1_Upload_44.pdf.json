            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF DEFENCE"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Defence of India and every part thereof including preparation for defence and all such acts as may be conducive in times of war to its prosecution, and after its termination to effective demobilisation."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "The Armed Forces of the Union, namely; Army; Navy and Air Force."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "The Reserves of the Army, Navy and Air Force."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "The Territorial Army and the Auxiliary Air Force."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "The National Cadet Corps, the Auxiliary Cadet Corps and the Lok Sahayak Sena."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Works relating to Army, Navy, Air Force and Ordnance Factories. 2273-A 2273-B THE GAZETTE OF INDIA EXTRAORDINARY"
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Remounts, Veterinary and Farms Organisation."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Canteen Stores Department (India)."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Civilian Services paid from Defence Estimates"
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Hydrographic surveys and preparation of navigational charts."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Formation of Cantonments, delimitation/excision of Cantonment arcas local self-government in such areas, the constitution and powers within such areas of Cantonment Boards and authorities and the regulation of house accommodation (Including the control of rents) in such areas."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Acquisition, requisitioning, custody and relinquishment of land and property for defence purposes. Eviction of unauthorised occupants from defence land and property."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Matters relating to ex-Servicemen including pensioners."
              },
              {
                "type": "department",
                "heading": "DEPARTMENT OF DEFENCE PRODUCTION"
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Defence Production and Inspection Organisation"
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Hindustan Aircraft Ltd."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Bharat Electronics Ltd."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Mazagon Docks Ltd., Bombay."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "Garden Reach Workshops Ltd., Calcufta."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "Defence Research and Development Organisation."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Any other matter that may be assigned by the Prime Minister from time to time."
              }
