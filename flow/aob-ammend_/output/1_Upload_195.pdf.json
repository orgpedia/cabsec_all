            },
            "content": [
              {
                "type": "ministry",
                "heading": "MINISTRY OF FOOD AND CIVIL SUPPLIES",
                "heading_hi": "KHADYA AUR NAGRIK POORTI MANTRALAYA"
              },
              {
                "type": "department",
                "num": "A",
                "heading": "DEPARTMENT OF FOOD",
                "heading_hi": "KHADYA VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "The following subjects which fall within List I of the Seventh Schedule to the Constitution of India: - 1 Purchase of foodstuffs for civil and military requirements and their disposal."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Participation in international conferences, associations and other bodies concerning food, e.g. International Wheat Council, International Sugar Council, World Food Council, International Food Policy Research Institute and implementation of decisions made thereat."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Entering into treaties and agreements with loreign countries and implementing of treaties, agreements conventions with foreign countries relating to trade and commerce in foodgraing and other foodstuffs"
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Hiring and acquisition of godowns for storage of foodgrains including sugar; taking on lease or acquiring land for construction of foodgrains godowns."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Inter-State trade and commerce in respect of foodgrains and other food-stuffs including sugar."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Industries, the control of which by the Union is declared by Parliament by Law to be expedient in public interest, as far as these relate to:"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Fruit and vegetable processing industry (including freezing and dehydration)."
              },
              {
                "type": "item",
                "num": "b",
                "text": "Sugar Industry (including development of gur and khandsari); and"
              },
              {
                "type": "item",
                "num": "c",
                "text": "Foodgrain milling industry."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Central Warchousing Corporation and the Warchousing Corporations. Jl. The following subjects which fall within List III of the Seventh Schedule to the Constitution of India (as regards legislation only):—"
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Trade and commerce in and supply and distribution of foodgrains."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Trade and commerce in and the production, supply and distribution of sugar and foodstuffs other than foodgrains."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Price control of foodgrains, foodstuffs and sugar"
              },
              {
                "type": "group_heading",
                "num": "III",
                "text": "For the subjects detailed in Parts 1 and II as well as the Food Administration of Delhi, the Andaman and Nicobar Islands and Lakshadweep."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "General and Consequential:"
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Matters relating to the following offices:-"
              },
              {
                "type": "item",
                "num": "i",
                "text": "Subordinate Offices under the Department of Food."
              },
              {
                "type": "item",
                "num": "ii",
                "text": "Directorate of Sugar, New Delhi."
              },
              {
                "type": "item",
                "num": "iii",
                "text": "National Sugar Institute, Kanpur."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Matters relating to the Development Council for Sugar Industry, New Delhi."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Offences against laws with respect to any of the subjects allotted to this Department."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Inquiries and statistics for the purpose of any of the subjects allotted to this Department."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Fecs in respect of any of the subjects allotted to this Department except fees taken in a court."
              },
              {
                "type": "department",
                "num": "B",
                "heading": "DEPARTMENT OF CIVIL SUPPLIES",
                "heading_hi": "NAGRIK POORTI VIBHAG"
              },
              {
                "type": "group_heading",
                "num": "I",
                "text": "Internal Trade:"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Internal Trade"
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Inter-State Trade, the Spirituous Preparations (Inter-State Trade and Commerce) Control Act"
              },
              {
                "type": "entry",
                "num": "1955"
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Control of futures trading [The Forward Contracts (Regulation) Act, 1952]."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "The Essential Commodities Act, 1955 (Supply prices and distribution of essential commodities not dealt with specifically by any other Ministry)"
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Prevention of Blackmarketing and Maintenance of supplies and Essential Commodities Act, 1980."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Consumer Cooperatives."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Public Distribution System."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Monitoring of prices and availability of essential commodities."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "The National Consumer Protection Council."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Regulation of packaged Commodities."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Training in Legal Metiology."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Industries, the control of which by the Union is declated by Parliament by law to be expedient in public interest, as far as these relate to Vanaspati Oil Seeds, Vegetable Oils, Cakes and Fats."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Price control of and inter-state trade and commerce in and supply and distribution of Vanaspati, Oil Seeds, Vegetable Oils, Cakes and fats."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Directorate of Vanaspati, Vegetable Oils and Fats"
              },
              {
                "type": "group_heading",
                "num": "II",
                "text": "Trade Marks, etc."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "The Trade and Merchandise Marks Act, 1958."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "The emblems and Names (Prevention of Improper Use) Act, 1950"
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Standards of Weights and Measures (The Standard> of Weights and Measures Act, 1956. The Standards of Weights and Measures Act, 1976)."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "The Indian Standards Institution (Certification Marks) Act, 1952."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "All attached or subordinate offices or other organisations concerned with any of the subjects specified in this list, including the Forward Markets Commission, Bombay."
              }
            ],
