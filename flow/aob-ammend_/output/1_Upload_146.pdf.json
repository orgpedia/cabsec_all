            "content": [
              {
                "type": "department",
                "heading": "DEPARTMENT OF DEFENCE RESEARCH AND DEVELOPMENT",
                "heading_hi": "RAKSHA ANUSANDHAN TATHA VIKAS VIBHAG"
              },
              {
                "type": "entry",
                "num": "24",
                "text": "Rendering advice to Raksha Mantri and to the three services and inter services organisations on all scientific aspects of Military operations, equipment and logistics. *G B S * ...2/- 1000 Copies. + - 2 -"
              },
              {
                "type": "entry",
                "num": "25",
                "text": "Formulation of Research, Design and Development Plans on -"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Armaments"
              },
              {
                "type": "item",
                "num": "b",
                "text": "Explosives"
              },
              {
                "type": "item",
                "num": "c",
                "text": "Electronics"
              },
              {
                "type": "item",
                "num": "d",
                "text": "Engineering"
              },
              {
                "type": "item",
                "num": "e",
                "text": "Rockets and Missiles"
              },
              {
                "type": "item",
                "num": "f",
                "text": "Vehicles"
              },
              {
                "type": "item",
                "num": "g",
                "text": "Meronautics"
              },
              {
                "type": "item",
                "num": "h",
                "text": "Naval Oceanography items i) Fire Research"
              },
              {
                "type": "item",
                "num": "j",
                "text": "Other Machinery and Equipments used by the three services"
              },
              {
                "type": "entry",
                "num": "26",
                "text": "Administration of the Defence Research and Development Organisation including the various Laboratories and Establishments in the Organisation."
              },
              {
                "type": "entry",
                "num": "27",
                "text": "Administration of the Defence Research and Development Service Rules, 1978 and other Service Rules pertaining to the Defence Research and Development Organisation (DRDO"
              },
              {
                "type": "entry",
                "num": "28",
                "text": "Defence Research and Development Council."
              },
              {
                "type": "entry",
                "num": "29",
                "text": "Framing of and promotion of personnel policies and labour relations."
              },
              {
                "type": "entry",
                "num": "30",
                "text": "Financial assistance to academic institutions, research laboratories and other agencies or bodies for furtherance of studies and research leading to promotion of Defence Research and Development."
              },
              {
                "type": "entry",
                "num": "31",
                "text": "Coordination of Scientific and Technological research and development work in the country with the work of Defence Research and Development Organisation."
              },
              {
                "type": "entry",
                "num": "32",
                "text": "Liaison with Research and Development Organisation in foreign countries particularly on aspects related to the field of Defence."
              },
              {
                "type": "entry",
                "num": "33",
                "text": "Any other matter that may be entrusted to the Department by the Prime Minister."
              }
