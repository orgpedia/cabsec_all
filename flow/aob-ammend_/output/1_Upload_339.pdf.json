            "content": [
              {
                "type": "department",
                "num": "D",
                "heading": "DEPARTMENT OF AIDS CONTROL",
                "heading_hi": "AIDS NIYANTRAN VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Inter-sectoral, inter-organisational and inter-institutional coordination, both, under the Central and State Governments in areas related to HIV/AIDS control and prevention."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Providing institutional framework for high end research for control, prevention cure and management of HIV/AIDS and all coordination in this regard."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Dissemination of accurate, complete and timely information about HIV/AIDS to motivate, equip and empower the people and promotion of measures for effective protection against the spread of the disease."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "National AIDS Control Organisation (NACO)."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "International co-operation, exchange programmes and advanced training in HIV/ AIDS management and research."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Promoting research studies in the field of HIV/AIDS prevention."
              }
            ],
