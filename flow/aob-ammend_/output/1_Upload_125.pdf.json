            "scope": "children",
            "content": [
              {
                "type": "entry",
                "num": "1",
                "text": "Formulation of policy statements and guidelines on science and technology and the following through of their implementation."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "National Committee on Science and Technology."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Promotion of new areas of science and technology."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Oceanography including the scientific and technological aspects of the seabed and ocean floor."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Environment and Ecology."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Futurology."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "All matters concerning the Council of Scientific and Industrial Research."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Survey of India and National Atlas Organisation."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "Botanical Survey of India."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "Zoological Survey of India."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "National Research Development Corporation"
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Annual Session of the Indian Science Congress Association."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Central Board of Geophysics."
              },
              {
                "type": "entry",
                "num": "14",
                "text": "The Pan-Indian Ocean Science Association."
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Coordination of areas of science and technology in which a number of institutions and departments have interests and capabilities."
              },
              {
                "type": "entry",
                "num": "16",
                "text": "Undertaking or financially sponsoring scientific and technological surveys, research, design, development where necessary."
              },
              {
                "type": "entry",
                "num": "17",
                "text": "Grants to national research institutions scientific associations and scientific bodies, including the Indian National Science Academy, the Indian Academy of Science and the National Academy of Sciences."
              },
              {
                "type": "entry",
                "num": "18",
                "text": "All matters concerning domestic technology particularly the promotion of ventures involving the commercialisation of such technology."
              },
              {
                "type": "entry",
                "num": "19",
                "text": "International Scientific and Technological Affairs including—"
              },
              {
                "type": "item",
                "num": "a",
                "text": "the negotiation and implementation of Scientific and Technological Cooperation Agreements and responsibility for the scientific and technological aspects of the activities of international organisations; and"
              },
              {
                "type": "item",
                "num": "b",
                "text": "appointment of Scientific Attachese abroad. SEC. 3 (II))"
              },
              {
                "type": "note",
                "text": "NOTE.—These functions shall be exercised by the Department of Science and Technology (Vigyan aur Prodyogiki Vibhag) in close cooperation with the Ministry of External Affairs (Videsh Mantralaya)."
              },
              {
                "type": "entry",
                "num": "20",
                "text": "Matters commonly affecting scientific and technological institutions e.g. financial, personnel, purchase and import policies and practices."
              },
              {
                "type": "entry",
                "num": "21",
                "text": "All other measures needed for the promotion of science and technology and their application to the development and security of the nation"
              }
            ],
