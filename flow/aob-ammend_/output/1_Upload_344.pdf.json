                "heading": "MINISTRY OF DRINKING WATER AND SANITATION",
                "heading_hi": "PEYA JAL AUR SWACHCHHATA MANTRALAYA"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Rural Water Supply (subject to overall national perspective of water planning and coordination assigned to the Ministry of Water Resources), sewage, drainage and sanitation relating to rural areas; International cooperation and technical assistance in this field."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Public cooperation, including matters relating to voluntary agencies in so far as they relate to rural water supply sewage, drainage and sanitation in rural areas."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Co-operatives relatable to the items in this list."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Coordination with respect to matters relating to drinking water supply projects and issues which cover both urban and rural areas."
              }
