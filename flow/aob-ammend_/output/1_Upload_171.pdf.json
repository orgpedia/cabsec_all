            "content": [
              {
                "type": "department",
                "num": "C",
                "heading": "DEPARTMENT OF COAL",
                "heading_hi": "KOYALA VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Exploration and development of coking and noncoking coal and lignite deposits in India."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "All malters relating to production, supply, distribution and prices of coal."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Development and operation of coal washeries other than those for which the Department of Steel (Tspat Vibhag) is responsible."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Low temperature carbonisation of coal and production of synthetic oil from coal."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Administation of the Coal Mines (Conservation and Develpment) Act, 1974."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Administration of the Coal Bearing Areas (Acquisition and Development) Act, 1957."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Public sector enterprises dealing with coal and lignite."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Administration of the Mines and Minerals (Regulation and Development) Act, 1957 and other Union Laws in so far as the said Act and Laws relate to coal and lignite and sand for stowing business incidental to such administration including questions concerning various States."
              }
