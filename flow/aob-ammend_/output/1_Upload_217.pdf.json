            "scope": "children",
            "content": [
              {
                "type": "entry",
                "num": "1",
                "text": "Planning for fertilizer production including import of fertilizer through a designated canalising agency."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Arrangements for movement and distribution of fertilizers in terms of allocations made by the Department of Agriculture and Cooperation."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Management of subsidy for indigenous and imported fertilizers including determination of 'retention' price and costing of imported fertilizers."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Administration of the Fertilizers (Movement Control) Order, 1960."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Administrative responsibility for public enterprises under the control of the Department."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "Public sector projects concerned with the subjects included under this Department except such projects as are specifically allotted to any other Ministry or Department."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Administrative responsibility for fertilizer production units in the cooperative seotor, namely, Indian Farmers' Cooperative Limited (IFFCO), Krishak Bharati Cooperative Limited (KRIBHCO)."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Administrative responsibility for the Indian Potash Limited (IPL)."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "All attached or subordinate offices or other organisations concerned with any of the subjects specified under this Department."
              }
