                "heading": "MINISTRY OF TRANSPORT AND AVIATION"
              },
              {
                "type": "department",
                "num": "A",
                "heading": "DEPARTMENT OF AVIATION AND TOURISM"
              },
              {
                "type": "entry",
                "num": "1",
                "text": "Meteorological Organisation."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Aircraft and air navigation; provision of aerodromes; regulation and organisation of air traffic and of aerodromes (excepting sanitary control of air navigation)."
