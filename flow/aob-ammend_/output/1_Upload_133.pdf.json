              {
                "type": "item",
                "num": "xi",
                "text": "Cardamom Board."
              },
              {
                "type": "group_heading",
                "num": "IV",
                "text": "State Trading"
              },
              {
                "type": "entry",
                "num": "14",
                "text": "Policies of State trading, and performance of organisations established for the purpose including: (1) State Trading Corporation and its subsidiaries, including-"
              },
              {
                "type": "item",
                "num": "a",
                "text": "Handicrafts & handlooms Export Corporation."
              },
              {
                "type": "item",
                "num": "b",
                "text": "Cashew Corporation of India."
              },
              {
                "type": "item",
                "num": "c",
                "text": "Project & Equipment Corporation."
              },
              {
                "type": "item",
                "num": "ii",
                "text": "Minerals & Metals Trading Corporation."
              },
              {
                "type": "group_heading",
                "num": "V",
                "text": "Trading with the enemy; Enemy property"
              },
              {
                "type": "entry",
                "num": "15",
                "text": "Trading with the enemy; enemy firms and enemy property; reparations (other than German Industrial equipment); Controller of Enemy Trading; Controller of Enemy Firms Custodian of Enemy Property for India"
              }
