            "content": [
              {
                "type": "department",
                "num": "C",
                "heading": "DEPARTMENT OF PHARMACEUTICALS",
                "heading_hi": "AUSHADH NIRMAN VIBHAG"
              },
              {
                "type": "entry",
                "num": "1",
                "text": ". Drugs and Pharmaceuticals, excluding those specifically allotted to other departments."
              },
              {
                "type": "entry",
                "num": "2",
                "text": "Promotion and co-ordination of basic, applied and other research in areas related to the pharmaceutical sector."
              },
              {
                "type": "entry",
                "num": "3",
                "text": "Development of infrastructure, manpower and skills for the pharmaceutical sector and management of related information."
              },
              {
                "type": "entry",
                "num": "4",
                "text": "Education and training including high end research and grant of fellowships in India and abroad, exchange of information and technical guidance on all matters relating to pharmaceutical sector."
              },
              {
                "type": "entry",
                "num": "5",
                "text": "Promotion of public - private - partnership in pharmaceutical related areas."
              },
              {
                "type": "entry",
                "num": "6",
                "text": "International co-operation in pharmaceutical research including work related to international conferences in related areas in India and abroad."
              },
              {
                "type": "entry",
                "num": "7",
                "text": "Inter-sectoral coordination including coordination between organizations and institutes under the Central and State Governments in areas related to the subjects entrusted to the Department."
              },
              {
                "type": "entry",
                "num": "8",
                "text": "Technical support for dealing with national hazards in pharmaceutical sector."
              },
              {
                "type": "entry",
                "num": "9",
                "text": "All matters relating to National Pharmaceutical Pricing Authority including related functions of price control/monitoring."
              },
              {
                "type": "entry",
                "num": "10",
                "text": "All matters relating to National Institutes for Pharmacy Education and Research."
              },
              {
                "type": "entry",
                "num": "11",
                "text": "Planning, development and control of, and assistance to all industries dealt with by the Department."
              },
              {
                "type": "entry",
                "num": "12",
                "text": "Bengal Chemicals and Pharmaceuticals Limited."
              },
              {
                "type": "entry",
                "num": "13",
                "text": "Hindustan Antibiotics Limited."
              },
              {
                "type": "entry",
                "num": "14",
